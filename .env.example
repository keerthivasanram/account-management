# ==============================================================================
# Instagram Account Management Platform — Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Initial Database: Supabase PostgreSQL (use port 6543 / 5432 with connection pooler)
# Future Database: Local PostgreSQL (e.g. postgresql://postgres:password@localhost:5432/instagram_mgmt)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & API Credentials
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# Frontend Supabase exposure
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Security & Token Encryption
# ------------------------------------------------------------------------------
# Fernet 32-byte URL-safe base64 key used to encrypt all Meta access tokens before database storage.
# Generate in Python via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=v7yv-Xz6V_wZJ39gQ5t0Q8_1Jz9r-3m3e91uGz_lZpY=

# ------------------------------------------------------------------------------
# 4. Meta Official OAuth Credentials
# ------------------------------------------------------------------------------
# Create an App at developers.facebook.com (Type: Business / Instagram Graph API)
META_APP_ID=1234567890123456
META_APP_SECRET=0123456789abcdef0123456789abcdef
META_REDIRECT_URI=http://localhost:5173/oauth/callback
META_API_VERSION=v19.0

# ------------------------------------------------------------------------------
# 5. Development Mode Settings
# ------------------------------------------------------------------------------
# Set to 'true' to allow Dev quick login bypass when Supabase Auth is not yet live
DEV_AUTH_BYPASS=true
